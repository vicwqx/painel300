# Aponte para o seu Postgres local (ou de produção, na Vercel via env vars do projeto)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/painel300?schema=public"

# Gere um valor aleatório: openssl rand -base64 32
AUTH_SECRET="troque-por-um-valor-aleatorio"

# URL onde a aplicação roda — em produção, a URL da Vercel
NEXTAUTH_URL="http://localhost:3000"
